# 首次使用时复制为 .env.development.local（已被 Git 忽略），再填写 SSH 地址。
# 可填写 user@host，或 ~/.ssh/config 中已配置的 Host 别名。
SSH_TARGET=your-user@your-server
# 留空时采用 OpenSSH 配置中的端口和默认密钥。
SSH_PORT=
SSH_IDENTITY_FILE=
# Ubuntu 后端依旧监听服务器的 127.0.0.1:8000。
SSH_REMOTE_PORT=8000
# SSH 本地转发端口，与 Vite 的代理目标共用此配置。
DEV_API_TARGET=http://127.0.0.1:18000
